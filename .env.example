# Environment Variables — TEMPLATE
# Copy this to .env and fill in your real values
# NEVER commit .env to Git

# ─── Weights & Biases (Experiment Tracking) ───────────────────────────────────
# Sign up at: https://wandb.ai
# Get API key from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=sugarcane-ai-obj1
WANDB_ENTITY=your_wandb_username_here

# ─── OpenWeatherMap (Historical Weather Data) ──────────────────────────────────
# Sign up at: https://openweathermap.org/api
# Free tier: 1000 calls/day — sufficient for metadata sync
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─── IBM Weather Company (Optional — Premium) ──────────────────────────────────
IBM_WEATHER_API_KEY=your_ibm_key_here

# ─── DVC Remote Storage (Dataset Versioning) ───────────────────────────────────
# Set up after DVC is configured
DVC_REMOTE_URL=gs://your-bucket-name/sugarcane-ai

# ─── Google Cloud (If using GCS for DVC remote) ────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json
